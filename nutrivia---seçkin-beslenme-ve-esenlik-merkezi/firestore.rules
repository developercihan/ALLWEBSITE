rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Chats collection
    match /chats/{chatId} {
      function isValidChat(data) {
        return data.keys().hasAll(['userId', 'updatedAt', 'status']) &&
               data.userId == request.auth.uid &&
               data.status in ['active', 'closed'];
      }

      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidChat(request.resource.data);
      allow update: if isSignedIn() && 
                    resource.data.userId == request.auth.uid && 
                    isValidChat(request.resource.data) &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt', 'status']);
    }

    // Messages subcollection
    match /chats/{chatId}/messages/{messageId} {
      function isValidMessage(data) {
        return data.keys().hasAll(['text', 'senderId', 'createdAt', 'chatId']) &&
               data.text is string && data.text.size() <= 2000 &&
               data.senderId == request.auth.uid &&
               data.chatId == chatId;
      }

      // Check if user is part of the chat
      function isChatParticipant(chatId) {
        return get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid;
      }

      allow read: if isSignedIn() && isChatParticipant(chatId);
      allow create: if isSignedIn() && isChatParticipant(chatId) && isValidMessage(request.resource.data);
    }
  }
}
